package game

// The manual: the Help tab's pages. Each line fits the panel (HELP_COLS characters, not counting the
// ^ marks); ^N, ^P and ^K draw the letter in its soil-bar colour.

HELP_COLS :: 42
HELP_LINES :: 13

Help_Page :: struct {
	title: string,
	lines: []string,
}

HELP := [?]Help_Page {
	{"Yer farm", {
		"This Metaphor is a farm on an 8 by 8",
		"field. Ye start with the middle four",
		"squares and $20.",
		"",
		"Plant crops, harvest them into the barn,",
		"sell them or keep them back as seed.",
		"Hire farmhands, buy land, grow.",
		"",
		"Nothing happens until ye end the turn",
		"(T). There is no goal but yer own.",
		"",
		"Tabs: Farm, Barn, Stats, Help (Tab).",
	}},
	{"Crops", {
		"Pick a crop (1-0, Q/E or a click) and",
		"press Space on bare soil to plant it.",
		"A seed of yer own is used first; with",
		"none, ye pay the seed price (Buy).",
		"",
		"Each crop grows 1 a turn and is ripe",
		"after its Grow turns. Its bar fills",
		"along the bottom of the square.",
		"",
		"Space on a ripe crop harvests it into",
		"the barn. Sell sets what one fetches.",
	}},
	{"Farmhands", {
		"A farmhand ($25) makes each crop in",
		"the 8 squares around them grow 1 more",
		"a turn. Two hands next to a crop stack.",
		"",
		"Every hand eats 1 meal a turn from the",
		"barn, the crop worth least per meal",
		"first. A hungry hand does no work and",
		"goes orange; hungry 3 turns, they quit.",
		"",
		"Space picks a hand up to move them;",
		"moved hands work from the next turn.",
		"D lets a hand go, with no refund.",
	}},
	{"Soil", {
		"Each square holds ^N, ^P and ^K, 0 to 4,",
		"shown as three bars on bare soil.",
		"",
		"A harvested crop takes what it uses and",
		"gives back what it gives: Soil -^P+^K",
		"means it takes ^P and gives ^K.",
		"",
		"A crop short of what it uses grows at",
		"half speed; its bar turns red.",
		"",
		"Rotate crops so each gives what the",
		"next needs, or spread manure (3, $4)",
		"to fill a square back up.",
	}},
	{"Ripe and rot", {
		"A ripe crop waits in the field, but not",
		"for ever: its bar counts down the turns",
		"it keeps, and it greys on the last.",
		"",
		"Left too long it rots. The soil still",
		"pays for it, and gets a little compost",
		"back, but ye get nothing.",
		"",
		"Harvest in time, or put a farmhand",
		"near crops ye cannot get to.",
	}},
	{"The barn", {
		"The barn holds 10 crops; seeds take no",
		"room. A harvest into a full barn is",
		"sold on the spot. B builds it bigger.",
		"",
		"Rats: each turn there is a chance they",
		"eat half of everything in the barn.",
		"A bigger barn draws more rats.",
		"",
		"Cats (C, $15) lower the chance, need no",
		"food, but may wander off any turn.",
	}},
	{"Crows", {
		"Each turn crows may eat any crop that",
		"is growing or ripe in the field.",
		"",
		"A scarecrow (2, $20) guards the 5x5",
		"around it. Guarded squares show small",
		"orange corners.",
		"",
		"The weather wears a scarecrow down; its",
		"bar shows how much is left. At nothing",
		"it falls apart. Space moves one; D",
		"takes it down.",
	}},
	{"Land", {
		"Wild land must be bought before ye can",
		"use it. Ye can buy a wild square that",
		"touches yer land on a side; those have",
		"a bright edge.",
		"",
		"Space on one buys it. Each square costs",
		"more than the last; the header shows",
		"the next price.",
	}},
	{"Licenses", {
		"Ye start allowed to grow carrots only.",
		"Every other crop needs a license,",
		"bought once, in any order ye like.",
		"",
		"The more a crop earns, the more its",
		"license costs: Radish $10 up to",
		"Pumpkin $150.",
		"",
		"Pick a locked crop and press L, or",
		"click its price in the Farm tab.",
	}},
	{"Seed and sell rules", {
		"In the Barn tab each crop has two",
		"numbers ye set:",
		"",
		"Seeds: keep this many seeds in stock.",
		"The barn turns crops into seed to top",
		"them up (, and . change it).",
		"",
		"Sell over: more than this in the barn",
		"is sold at once (; and ' change it).",
		"'-' means never. Keep enough to feed",
		"yer farmhands.",
	}},
	{"Keys", {
		"Arrows move, Space acts, T ends turn.",
		"1-0, Q/E: pick a tool. Tab: next tab.",
		"X sell one, A sell all, Z keep seed.",
		"L license, B bigger barn, C cat.",
		"D let go. , . seeds  ; ' sell over.",
		"PgUp/PgDn: pages. N twice: new farm.",
		"M sound.",
		"",
		"Pad: d-pad moves, A acts, LB/RB tools,",
		"X sell, Y seed, Start ends the turn,",
		"Back next tab.",
		"",
		"Everything can be clicked or tapped.",
	}},
}
